<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MUTASSIM.ToolPro.App.ViewModels"
                    xmlns:v="clr-namespace:MUTASSIM.ToolPro.App.Views"
                    xmlns:conv="clr-namespace:MUTASSIM.ToolPro.App.Converters"
                    xmlns:ws="clr-namespace:MUTASSIM.ToolPro.App.Workspace">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Gsm.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared converters -->
    <conv:EnumTextConverter x:Key="EnumText" />
    <conv:StatusBrushConverter x:Key="StatusBrush" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <conv:FileSizeConverter x:Key="FileSize" />
    <conv:InverseBoolConverter x:Key="InverseBool" />

    <!-- View model → view (MVVM navigation) -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeviceManagerViewModel}"><v:DeviceManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModulePageViewModel}"><v:ModulePageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FirmwareManagerViewModel}"><v:FirmwareManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OperationHistoryViewModel}"><v:OperationHistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PluginsViewModel}"><v:PluginsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TerminalViewModel}"><v:TerminalView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsbDriversViewModel}"><v:UsbDriversView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AssistViewModel}"><v:AssistView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SamsungFlashViewModel}"><v:SamsungFlashView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountViewModel}"><v:AccountView /></DataTemplate>
    <DataTemplate DataType="{x:Type ws:WorkspaceViewModel}"><v:WorkspaceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InfoPanelViewModel}"><v:DeviceInfoCard /></DataTemplate>

    <!-- Page header used by every view -->
    <Style x:Key="PageRoot" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="14,10,10,10" />
    </Style>

    <!-- Status badge for ImplementationStatus / OperationStatus / etc. (DataContext = the enum value) -->
    <DataTemplate x:Key="StatusBadge">
        <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{Binding Converter={StaticResource StatusBrush}}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{Binding Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Converter={StaticResource EnumText}}" Margin="6,0,0,0" FontSize="11"
                           Foreground="{Binding Converter={StaticResource StatusBrush}}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
