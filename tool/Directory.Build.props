<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>MUTASSIM SOFTWARE</Company>
    <Product>MUTASSIM TOOL PRO</Product>
    <Authors>MUTASSIM SOFTWARE</Authors>
    <Copyright>© MUTASSIM SOFTWARE. All rights reserved.</Copyright>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Engine libraries must stay UI-agnostic. Only the App project targets Windows/WPF. -->
    <EngineTargetFramework>net10.0</EngineTargetFramework>
  </PropertyGroup>
</Project>
