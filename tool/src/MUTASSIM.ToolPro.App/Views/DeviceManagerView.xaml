<UserControl x:Class="MUTASSIM.ToolPro.App.Views.DeviceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Devices.Scan}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Nav.DeviceManager}" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{DynamicResource Devices.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Detection engines -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Devices.Engines}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Brush.OrangeSoft}" CornerRadius="2" Padding="12,10"
                            Visibility="{Binding HasDetectors, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Orange}" />
                            <TextBlock Text="{DynamicResource Devices.NoEngines}" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Detectors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding IsAvailable, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Muted}">
                                        <Run Text="{Binding DeviceCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource Devices.DevicesWord}" />
                                        <Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" />
                                        <Run Text="{Binding LastError, Mode=OneWay}" Foreground="{StaticResource Brush.Error}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="32"
                    Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Text.Icon}" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{DynamicResource Devices.Empty}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{DynamicResource Devices.EmptyHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="520" />
                </StackPanel>
            </Border>

            <!-- Device cards -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="2" Background="{StaticResource Brush.AccentSoft}">
                                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Text.Icon}" FontSize="22"
                                                   Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Badge}" Margin="0,12,0,0" Background="{StaticResource Brush.Surface2}"
                                        BorderBrush="{Binding Mode, Converter={StaticResource StatusBrush}}" BorderThickness="1">
                                    <TextBlock Text="{Binding ModeText}" FontSize="11"
                                               Foreground="{Binding Mode, Converter={StaticResource StatusBrush}}" />
                                </Border>

                                <Rectangle Style="{StaticResource Divider}" />

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Value}"
                                                           FlowDirection="LeftToRight" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0">
                                    <Run Text="{DynamicResource Devices.Modules}" /><Run Text=": " />
                                    <Run Text="{Binding ModulesText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                                </TextBlock>

                                <Button Style="{StaticResource Btn.Primary}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding HasModule}"
                                        Command="{Binding DataContext.OpenServicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{DynamicResource Devices.OpenServices}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
