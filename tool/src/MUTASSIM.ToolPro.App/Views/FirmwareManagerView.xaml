<UserControl x:Class="MUTASSIM.ToolPro.App.Views.FirmwareManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Nav.Firmware}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{DynamicResource Firmware.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,16" />

            <!-- Drop zone -->
            <Border x:Name="DropZone" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1.5" CornerRadius="2"
                    Background="{StaticResource Brush.AccentSoft}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" FontSize="34" Foreground="{StaticResource Brush.Accent}" />
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Firmware.DropTitle}" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{DynamicResource Firmware.DropHint}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BrowseCommand}" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Firmware.Browse}" />
                        </Button>
                        <Button Style="{StaticResource Btn.Accent}" Command="{Binding HashAllCommand}" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Firmware.VerifyAll}" />
                        </Button>
                        <Button Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Common.Cancel}" />
                        </Button>
                        <Button Command="{Binding ClearCommand}">
                            <TextBlock Text="{DynamicResource Common.Clear}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource Firmware.Empty}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,20"
                       Visibility="{Binding Files.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" FlowDirection="LeftToRight"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSize}}" Style="{StaticResource Text.Muted}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding State, Converter={StaticResource EnumText}}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource Brush.Accent}" />
                                    </StackPanel>

                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,10,0,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SHA-256" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Sha256, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" FlowDirection="LeftToRight" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Firmware.Expected}" Style="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center" Margin="0,6,0,0" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                                 Text="{Binding ExpectedHash, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" FlowDirection="LeftToRight" />
                                    </Grid>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Btn.Primary}" Margin="0,0,0,6" IsEnabled="{Binding IsIdle}"
                                            Command="{Binding DataContext.HashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Firmware.Verify}" />
                                    </Button>
                                    <Button Margin="0,0,0,6"
                                            Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasHash}">
                                        <TextBlock Text="{DynamicResource Firmware.CopyHash}" />
                                    </Button>
                                    <Button Margin="0,0,0,6"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Firmware.OpenFolder}" />
                                    </Button>
                                    <Button IsEnabled="{Binding IsIdle}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Common.Remove}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
