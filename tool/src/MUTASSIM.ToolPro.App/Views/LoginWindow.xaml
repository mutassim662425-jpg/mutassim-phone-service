<Window x:Class="MUTASSIM.ToolPro.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MUTASSIM TOOL PRO"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontSize="13"
        FlowDirection="{Binding Localization.FlowDirection, FallbackValue=LeftToRight}">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MUTASSIM TOOL PRO" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Gold}" />
            <TextBlock Text="{DynamicResource Login.Subtitle}" Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Login.Email}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,2,0,10" />

                    <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource Text.Label}" />
                    <PasswordBox x:Name="Pwd" FlowDirection="LeftToRight" Margin="0,2,0,14" PasswordChanged="Pwd_Changed" />

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />

                    <!-- Sign in -->
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding SubmitCommand}" Padding="0,10" HorizontalAlignment="Stretch"
                            IsDefault="True"
                            IsEnabled="{Binding Busy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="{DynamicResource Login.SignIn}" FontWeight="Bold" />
                    </Button>
                    <!-- Create account -->
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding SubmitCommand}" Padding="0,10" HorizontalAlignment="Stretch"
                            IsDefault="True"
                            IsEnabled="{Binding Busy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Login.CreateAccount}" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Mode toggle -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock Text="{DynamicResource Login.NoAccount}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                           Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock Text="{DynamicResource Login.HaveAccount}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                           Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding ToggleModeCommand}" Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand">
                    <Grid>
                        <TextBlock Text="{DynamicResource Login.CreateAccount}" Foreground="{StaticResource Brush.Gold}" FontWeight="Bold"
                                   Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <TextBlock Text="{DynamicResource Login.SignIn}" Foreground="{StaticResource Brush.Gold}" FontWeight="Bold"
                                   Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
