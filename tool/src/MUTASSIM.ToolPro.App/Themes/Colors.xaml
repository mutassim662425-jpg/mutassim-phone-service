<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== MUTASSIM TOOL PRO — black / gold GSM theme ===== -->
    <Color x:Key="Color.Background">#0B0C0E</Color>
    <Color x:Key="Color.Surface">#14161A</Color>
    <Color x:Key="Color.Surface2">#1C1F25</Color>
    <Color x:Key="Color.SurfaceHover">#262A32</Color>
    <Color x:Key="Color.Border">#2A2E36</Color>
    <Color x:Key="Color.PanelBorder">#4A3A18</Color>
    <Color x:Key="Color.Text">#EDEFF2</Color>
    <Color x:Key="Color.TextMuted">#8E96A3</Color>
    <Color x:Key="Color.Accent">#2F80ED</Color>
    <Color x:Key="Color.AccentDark">#2468C4</Color>
    <Color x:Key="Color.Orange">#F5A623</Color>
    <Color x:Key="Color.OrangeDark">#D98A0B</Color>
    <Color x:Key="Color.Success">#2ECC71</Color>
    <Color x:Key="Color.Warning">#F1C40F</Color>
    <Color x:Key="Color.Error">#E8414C</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}" />
    <SolidColorBrush x:Key="Brush.OrangeDark" Color="{StaticResource Color.OrangeDark}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#262F80ED" />
    <SolidColorBrush x:Key="Brush.OrangeSoft" Color="#26F5A623" />
    <SolidColorBrush x:Key="Brush.OnGold" Color="#1A1000" />

    <!-- Gold gradient: selected tab, selected model, primary action -->
    <LinearGradientBrush x:Key="Brush.Gold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFC24A" Offset="0" />
        <GradientStop Color="#F09A12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GoldHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD27A" Offset="0" />
        <GradientStop Color="#F5A623" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Orange}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.HeroGradient" Color="{StaticResource Color.Surface}" />

    <!-- Raised operation button -->
    <LinearGradientBrush x:Key="Brush.OpButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20242B" Offset="0" />
        <GradientStop Color="#181B20" Offset="1" />
    </LinearGradientBrush>

    <!-- Brand button gloss (drawn over the brand colour) -->
    <LinearGradientBrush x:Key="Brush.Gloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.5" />
        <GradientStop Color="#22000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Generic phone illustration (our own drawing) -->
    <LinearGradientBrush x:Key="Brush.PhoneBody" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A4250" Offset="0" />
        <GradientStop Color="#1E232B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PhoneScreen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D4E89" Offset="0" />
        <GradientStop Color="#5B3E9E" Offset="0.55" />
        <GradientStop Color="#0F1B2E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.LogBackground" Color="#08090B" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#0B0C0E" />

    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
