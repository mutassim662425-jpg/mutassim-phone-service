<UserControl x:Class="MUTASSIM.ToolPro.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Background="{StaticResource Brush.HeroGradient}" Padding="24" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/MutassimToolPro;component/Assets/logo.png" Width="72" Height="72"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Run Text="MUTASSIM" /><Run Text=" TOOL PRO " Foreground="{StaticResource Brush.Accent}" /><Run Text="{Binding DisplayVersion, Mode=OneWay}" Foreground="{StaticResource Brush.Orange}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Run Text="{Binding Developer, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Slogan, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Run Text="Build " /><Run Text="{Binding InformationalVersion, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Runtime, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status summary -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource About.StatusMatrix}" Style="{StaticResource Text.H2}" />
            <TextBlock Text="{DynamicResource About.StatusMatrixHint}" Style="{StaticResource Text.Muted}" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding Counts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" />
                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{StaticResource About.Col.Module}" Binding="{Binding Module}" Width="170" />
                    <DataGridTextColumn Header="{StaticResource Module.Col.Service}" Binding="{Binding Service}" Width="2*" />
                    <DataGridTemplateColumn Header="{StaticResource Module.Col.Status}" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{StaticResource Module.Col.Phase}" Binding="{Binding Phase}" Width="80" />
                    <DataGridTextColumn Header="{StaticResource About.Col.Notes}" Binding="{Binding Notes}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
