<UserControl x:Class="MUTASSIM.ToolPro.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Plugins.OpenFolder}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Nav.Plugins}" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{DynamicResource Plugins.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0">
                        <Run Text="{DynamicResource Plugins.Folder}" /><Run Text=": " />
                        <Run Text="{Binding PluginsDirectory, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                        <Run Text="  ·  Host API v" /><Run Text="{Binding HostApiVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Padding="32"
                    Visibility="{Binding Plugins, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xEA86;" Style="{StaticResource Text.Icon}" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{DynamicResource Plugins.Empty}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{DynamicResource Plugins.EmptyHint}" Style="{StaticResource Text.Muted}" TextAlignment="Center" MaxWidth="560" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding State}" ContentTemplate="{StaticResource StatusBadge}" />
                                    <TextBlock Style="{StaticResource Text.H2}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  v" /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0">
                                    <Run Text="{DynamicResource Plugins.Vendor}" /><Run Text=": " /><Run Text="{Binding Vendor, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Muted}">
                                    <Run Text="{DynamicResource Plugins.Devices}" /><Run Text=": " /><Run Text="{Binding Devices, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Muted}">
                                    <Run Text="{DynamicResource Plugins.Services}" /><Run Text=": " /><Run Text="{Binding Services, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Muted}">
                                    <Run Text="{DynamicResource Plugins.Requirements}" /><Run Text=": " /><Run Text="{Binding Requirements, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
