<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pin the native SQLite bundle to 2.1.14 to clear CVE-2025-6965 (NU1903).
         Microsoft.Data.Sqlite 10.0.0 pulls SQLitePCLRaw 2.1.11 transitively, which is flagged;
         2.1.14 ships patched SQLite. This reference raises the resolved version for every
         project that references Core (Server, Tests, Device Agent). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

</Project>
