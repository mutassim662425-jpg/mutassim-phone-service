<UserControl x:Class="MUTASSIM.ToolPro.App.Views.UsbDriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Command="{Binding RefreshCommand}">
                <TextBlock Text="{DynamicResource Devices.Scan}" />
            </Button>
            <StackPanel>
                <TextBlock Text="{DynamicResource Nav.UsbDrivers}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{DynamicResource Drivers.Subtitle}" Style="{StaticResource Text.Muted}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPid}" Width="90" />
                    <DataGridTextColumn Header="{StaticResource Drivers.Col.Vendor}" Binding="{Binding Vendor}" Width="120" />
                    <DataGridTextColumn Header="{StaticResource Drivers.Col.Name}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="COM" Binding="{Binding ComPort}" Width="70" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Mode}" Binding="{Binding Mode}" Width="140" />
                    <DataGridTemplateColumn Header="{StaticResource Drivers.Col.Driver}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Driver, Converter={StaticResource EnumText}}"
                                           Foreground="{Binding Driver, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="2" Style="{StaticResource Text.Muted}" Margin="0,8,0,0">
            <Run Text="{Binding Entries.Count, Mode=OneWay}" /><Run Text=" USB · " />
            <Run Text="{DynamicResource Drivers.Problems}" /><Run Text=": " /><Run Text="{Binding MissingCount, Mode=OneWay}" Foreground="{StaticResource Brush.Orange}" />
            <Run Text="  ·  " /><Run Text="{DynamicResource Drivers.Hint}" />
        </TextBlock>
    </Grid>
</UserControl>
