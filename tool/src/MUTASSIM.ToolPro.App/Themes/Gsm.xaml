<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================= Panels ================= -->
    <Style x:Key="GoldPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Orange}" />
    </Style>

    <!-- ================= Brand bar (coloured buttons) =================
         Background = brand colour (bound). Checked = white frame. Text is the plain brand name. -->
    <Style x:Key="BrandBarRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border Background="{StaticResource Brush.Gloss}" CornerRadius="4" IsHitTestVisible="False" />
                        <Border x:Name="Hover" Background="#18FFFFFF" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="Frame" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" />
                        <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Orange}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Mode tabs (BROM / EDL / ADB … style) ================= -->
    <Style x:Key="ModeTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Brush.Surface2}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="3,3,0,0" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Gold}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnGold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Operation row ([icon]  TEXT) ================= -->
    <Style x:Key="OpRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Brush.OpButton}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gold primary button -->
    <Style x:Key="Btn.Gold" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Gold}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Orange}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnGold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Tag" Value="{StaticResource Brush.GoldHover}" />
    </Style>

    <!-- Small copy button inside info rows -->
    <Style x:Key="Btn.Copy" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Content" Value="&#xE8C8;" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <!-- ================= Model list item ================= -->
    <Style x:Key="ModelListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnGold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Search box with placeholder + icon (Tag = placeholder text) ================= -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Orange}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid Margin="10,0,8,0">
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Brush.TextMuted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="15" Foreground="{StaticResource Brush.Orange}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Generic phone illustration (original drawing, no brand artwork) ================= -->
    <ControlTemplate x:Key="PhoneGlyph" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="80" Height="150">
                <Border Canvas.Left="2" Canvas.Top="2" Width="76" Height="146" CornerRadius="12"
                        Background="{StaticResource Brush.PhoneBody}" BorderBrush="#5A6372" BorderThickness="1.5" />
                <Border Canvas.Left="7" Canvas.Top="8" Width="66" Height="134" CornerRadius="8"
                        Background="{StaticResource Brush.PhoneScreen}" />
                <Ellipse Canvas.Left="37" Canvas.Top="12" Width="6" Height="6" Fill="#0A0C10" />
                <Path Canvas.Left="12" Canvas.Top="60" Data="M0,40 C15,10 35,0 56,18 L56,60 L0,60 Z" Fill="#33FFFFFF" />
                <Rectangle Canvas.Left="78" Canvas.Top="38" Width="2" Height="20" Fill="#5A6372" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- ================= Connection bar pill ================= -->
    <Style x:Key="ModePill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Height" Value="30" />
    </Style>
</ResourceDictionary>
