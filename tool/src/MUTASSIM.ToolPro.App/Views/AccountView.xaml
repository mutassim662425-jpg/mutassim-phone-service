<UserControl x:Class="MUTASSIM.ToolPro.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Nav.Account}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{DynamicResource Account.Subtitle}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,16" />

            <!-- Signed OUT: login -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="{Binding Session.IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Account.SignIn}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Account.User}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,2,0,8" />
                    <TextBlock Text="{DynamicResource Account.Pass}" Style="{StaticResource Text.Label}" />
                    <PasswordBox x:Name="Pwd" FlowDirection="LeftToRight" Margin="0,2,0,12" PasswordChanged="Pwd_Changed" />
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding LoginCommand}" Padding="20,8" HorizontalAlignment="Left"
                            IsEnabled="{Binding Busy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="{DynamicResource Account.SignIn}" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Signed IN: balance + actions -->
            <StackPanel Visibility="{Binding Session.IsLoggedIn, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding LogoutCommand}" VerticalAlignment="Center" Padding="14,6">
                            <TextBlock Text="{DynamicResource Account.SignOut}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" Margin="0,0,8,0"
                                Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Account.Refresh}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="Bold">
                                <Run Text="{Binding Session.Account.Username, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding Session.Account.Role, Mode=OneWay}" Foreground="{StaticResource Brush.Gold}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Black" Foreground="{StaticResource Brush.Gold}">
                                <Run Text="{Binding Session.Account.Balance, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource Account.Credits}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="{Binding Info}" Foreground="{StaticResource Brush.Success}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding Info, Converter={StaticResource EmptyToCollapsed}}" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />

                <!-- Admin / Distributor: manage sub-accounts -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding Session.IsDistributor, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Account.Manage}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource Account.NewAccount}" Style="{StaticResource Text.Label}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,6,0" ToolTip="{DynamicResource Account.User}" />
                            <TextBox Grid.Column="1" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,6,0" ToolTip="{DynamicResource Account.Pass}" />
                            <CheckBox Grid.Column="2" Content="{DynamicResource Account.AsDistributor}" IsChecked="{Binding NewIsDistributor}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Visibility="{Binding Session.IsAdmin, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="3" Command="{Binding CreateChildCommand}" Padding="14,6">
                                <TextBlock Text="{DynamicResource Account.Create}" />
                            </Button>
                        </Grid>

                        <TextBlock Text="{DynamicResource Account.AddCredits}" Style="{StaticResource Text.Label}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}" DisplayMemberPath="Username" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding CreditAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,6,0" ToolTip="{DynamicResource Account.Amount}" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.Gold}" Command="{Binding AddCreditsCommand}" Padding="14,6">
                                <TextBlock Text="{DynamicResource Account.Add}" />
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Children}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Brush.Gold}" FontWeight="Bold">
                                            <Run Text="{Binding Balance, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource Account.Credits}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Username}" /><TextBlock Text="  " /><TextBlock Text="{Binding Role}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Pricing -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Account.Pricing}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Pricing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" Foreground="{StaticResource Brush.Gold}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TitleEn}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ledger -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Account.History}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Ledger}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceAfter}" Foreground="{StaticResource Brush.TextMuted}" Margin="10,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Delta}" FontWeight="Bold" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right" />
                                            <TextBlock Text="{Binding Kind}" MinWidth="90" /><TextBlock Text="{Binding Reference}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
