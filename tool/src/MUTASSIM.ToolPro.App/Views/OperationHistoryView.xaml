<UserControl x:Class="MUTASSIM.ToolPro.App.Views.OperationHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Nav.History}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{DynamicResource History.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,16" />
        </StackPanel>

        <!-- Filters -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ExportCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource Text.Icon}" FontSize="13" />
                        <TextBlock Text="{DynamicResource History.Export}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSelectedCommand}" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource History.DeleteSelected}" />
                </Button>
                <Button Style="{StaticResource Btn.Accent}" Command="{Binding ClearAllCommand}" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource History.ClearAll}" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding SearchCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Common.Search}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <ComboBox Width="170" Margin="12,0,0,0" ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Title" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Date}" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Device}" Binding="{Binding Manufacturer}" Width="110" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Model}" Binding="{Binding Model}" Width="120" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Mode}" Binding="{Binding Mode, Converter={StaticResource EnumText}}" Width="110" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Service}" Binding="{Binding ServiceName}" Width="2*" />
                    <DataGridTemplateColumn Header="{StaticResource History.Col.Status}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{StaticResource History.Col.Duration}" Binding="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss\\.f}}" Width="90" />
                    <DataGridTextColumn Header="{StaticResource History.Col.Result}" Binding="{Binding ResultMessage}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Text.Muted}" Margin="0,8,0,0">
            <Run Text="{Binding ResultCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource History.Records}" />
            <Run Text="  ·  " /><Run Text="{DynamicResource History.Privacy}" />
        </TextBlock>
    </Grid>
</UserControl>
