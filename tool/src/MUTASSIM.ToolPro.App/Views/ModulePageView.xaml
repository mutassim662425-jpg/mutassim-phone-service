<UserControl x:Class="MUTASSIM.ToolPro.App.Views.ModulePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{DynamicResource Module.Intro}" Style="{StaticResource Text.Muted}" Margin="0,4,0,16" />

            <Border Background="{StaticResource Brush.OrangeSoft}" CornerRadius="2" Padding="12,10" Margin="0,0,0,16"
                    Visibility="{Binding MissingModule, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Module.Missing}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.H2}" FontSize="18" />
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.AccentSoft}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CategoryText}" FontSize="11" Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" FontSize="12.5" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                           Visibility="{Binding Brands, Converter={StaticResource EmptyToCollapsed}}">
                                    <Run Text="{DynamicResource Module.Brands}" /><Run Text=": " />
                                    <Run Text="{Binding Brands, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                                </TextBlock>

                                <!-- Connected compatible devices -->
                                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="2" Padding="10,8" Margin="0,10,0,0"
                                        Visibility="{Binding ConnectedDevices.Count, Converter={StaticResource EmptyToCollapsed}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Module.ConnectedNow}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                                        <ItemsControl ItemsSource="{Binding ConnectedDevices}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Services table -->
                                <Grid Margin="0,14,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Module.Col.Service}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Module.Col.Modes}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Module.Col.Phase}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Module.Col.Status}" Style="{StaticResource Text.Label}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Services}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*" />
                                                        <ColumnDefinition Width="1.3*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="230" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="12"
                                                                       Foreground="{StaticResource Brush.Orange}" Margin="6,0,0,0"
                                                                       ToolTip="{DynamicResource Module.Destructive}"
                                                                       Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Muted}" FontSize="11"
                                                                   Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Modes}" Style="{StaticResource Text.Muted}"
                                                               VerticalAlignment="Center" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Phase}" Style="{StaticResource Text.Muted}"
                                                               VerticalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="3" Content="{Binding Status}"
                                                                      ContentTemplate="{StaticResource StatusBadge}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
